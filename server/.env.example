# Copy this file to .env and fill in your values.
PORT=5000
NODE_ENV=development

# NVIDIA NIM — get a key at https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b

# Storage (relative to the server/ folder)
DOWNLOAD_DIR=downloads
DATABASE_URL=db/vidmind.sqlite

# Python executable that has yt-dlp + youtube-transcript-api installed
PYTHON_BIN=python

# Comma-separated list of allowed frontend origins (use * only for local dev)
CORS_ORIGIN=http://localhost:5173

# Abuse protection
RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_DOWNLOADS=3
MAX_VIDEO_DURATION_SECONDS=9000

# JavaScript runtime yt-dlp uses to solve YouTube challenges (node | deno | bun)
YTDLP_JS_RUNTIME=node

# Optional: path to a Netscape-format cookies.txt (helps when YouTube blocks server IPs)
YTDLP_COOKIES_FILE=

# Optional: cookies.txt from a logged-in Instagram session (needed when Instagram blocks anonymous requests)
INSTAGRAM_COOKIES_FILE=
